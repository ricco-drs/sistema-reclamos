person "==Estudiante\n<size:16>[Person]</size>\n\nPresenta reclamos de matrícula y consulta a Tefi." <<Element-RWxlbWVudCxQZXJzb24=>> as Estudiante
person "==Miembro del Tercio\n<size:16>[Person]</size>\n\nRevisa los reclamos, decide los cursos y responde." <<Element-RWxlbWVudCxQZXJzb24=>> as MiembrodelTercio
rectangle "==Google Gemini\n<size:16>[Software System]</size>\n\nModelo de lenguaje con File Search." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as GoogleGemini
rectangle "==Proveedores de correo\n<size:16>[Software System]</size>\n\nBrevo, Resend y Mailjet." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as Proveedoresdecorreo
rectangle "==Firebase Authentication\n<size:16>[Software System]</size>\n\nCuentas del panel del Tercio." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as FirebaseAuthentication
rectangle "==Servicio M2\n<size:16>[Software System]</size>\n\nRecibe el expediente de cada reclamo." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as ServicioM2
rectangle "==TEFIIS\n<size:16>[Software System]</size>\n\nRegistra y resuelve los reclamos de matrícula." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as TEFIIS

TEFIIS --> FirebaseAuthentication <<Relationship-UmVsYXRpb25zaGlw>> : "Autentica a los miembros del Tercio\n<size:16>[Firebase SDK y Admin SDK]</size>"
Proveedoresdecorreo --> Estudiante <<Relationship-UmVsYXRpb25zaGlw>> : "Entrega códigos, confirmaciones y respuestas\n<size:16>[Correo electrónico]</size>"
Estudiante --> TEFIIS <<Relationship-UmVsYXRpb25zaGlw>> : "Presenta reclamos, consulta a Tefi y sigue sus casos\n<size:16>[HTTPS]</size>"
MiembrodelTercio --> TEFIIS <<Relationship-UmVsYXRpb25zaGlw>> : "Revisa reclamos, decide cursos y responde\n<size:16>[HTTPS]</size>"
TEFIIS --> ServicioM2 <<Relationship-UmVsYXRpb25zaGlw>> : "Registra el expediente\n<size:16>[JSON/HTTPS]</size>"
TEFIIS --> GoogleGemini <<Relationship-UmVsYXRpb25zaGlw>> : "Envía preguntas con búsqueda en los reglamentos\n<size:16>[JSON/HTTPS]</size>"
TEFIIS --> Proveedoresdecorreo <<Relationship-UmVsYXRpb25zaGlw>> : "Envía códigos, confirmaciones y respuestas\n<size:16>[JSON/HTTPS]</size>"

