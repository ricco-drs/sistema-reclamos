# Configuración del panel del Tercio. Copia este archivo a .env y complétalo.
# Vite incluye estas variables en el JavaScript que recibe el navegador, así que
# aquí no va nada secreto: las claves privadas viven en el .env del backend.

# Firebase Authentication (inicio de sesión del panel).
# Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: solo para Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# API de TEFIIS. Sin esta variable el panel usa http://localhost:3005.
VITE_API_URL=

# URL del proyecto de Supabase, para armar la ruta de los documentos del bucket.
VITE_SUPABASE_URL=
