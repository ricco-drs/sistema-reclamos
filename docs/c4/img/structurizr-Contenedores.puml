person "==Estudiante\n<size:16>[Person]</size>\n\nPresenta reclamos de matrícula y consulta a Tefi." <<Element-RWxlbWVudCxQZXJzb24=>> as Estudiante
person "==Miembro del Tercio\n<size:16>[Person]</size>\n\nRevisa los reclamos, decide los cursos y responde." <<Element-RWxlbWVudCxQZXJzb24=>> as MiembrodelTercio
rectangle "==Google Gemini\n<size:16>[Software System]</size>\n\nModelo de lenguaje con File Search." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as GoogleGemini
rectangle "==Proveedores de correo\n<size:16>[Software System]</size>\n\nBrevo, Resend y Mailjet." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as Proveedoresdecorreo
rectangle "==Firebase Authentication\n<size:16>[Software System]</size>\n\nCuentas del panel del Tercio." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as FirebaseAuthentication
rectangle "==Servicio M2\n<size:16>[Software System]</size>\n\nRecibe el expediente de cada reclamo." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sU2lzdGVtYSBleHRlcm5v>> as ServicioM2

rectangle "TEFIIS\n<size:16>[Software System]</size>" <<Boundary-VEVGSUlT>> {
  rectangle "==API TEFIIS\n<size:16>[Container: Node.js 22, Express 5]</size>\n\nReglas de reclamos, sesiones, Tefi, correos y auditoría." <<Element-RWxlbWVudCxDb250YWluZXI=>> as TEFIIS.APITEFIIS
  database "==Base de datos\n<size:16>[Container: PostgreSQL en Supabase]</size>\n\nreclamos, respuestas_reclamo, activity_log, conversaciones, app_settings, documentos_estudiante." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as TEFIIS.Basededatos
  database "==Archivos\n<size:16>[Container: Supabase Storage]</size>\n\nPDF del SIGA y evidencias." <<Element-RWxlbWVudCxDb250YWluZXIsQWxtYWPDqW4gZGUgZGF0b3M=>> as TEFIIS.Archivos
  rectangle "==Aplicación de estudiantes\n<size:16>[Container: React 19, TypeScript, Vite]</size>\n\nReclamos, chat con Tefi, perfil y seguimiento." <<Element-RWxlbWVudCxDb250YWluZXI=>> as TEFIIS.Aplicacióndeestudiantes
  rectangle "==Panel del Tercio\n<size:16>[Container: React, repositorio sistema-admin]</size>\n\nBandeja, expediente, estados, cursos resueltos y respuestas." <<Element-RWxlbWVudCxDb250YWluZXI=>> as TEFIIS.PaneldelTercio
}

Estudiante --> TEFIIS.Aplicacióndeestudiantes <<Relationship-UmVsYXRpb25zaGlw>> : "Presenta reclamos, consulta a Tefi y sigue sus casos\n<size:16>[HTTPS]</size>"
MiembrodelTercio --> TEFIIS.PaneldelTercio <<Relationship-UmVsYXRpb25zaGlw>> : "Revisa reclamos, decide cursos y responde\n<size:16>[HTTPS]</size>"
TEFIIS.Aplicacióndeestudiantes --> TEFIIS.APITEFIIS <<Relationship-UmVsYXRpb25zaGlw>> : "Reclamos, documentos y preguntas a Tefi\n<size:16>[JSON/HTTPS, JWT]</size>"
TEFIIS.Aplicacióndeestudiantes --> ServicioM2 <<Relationship-UmVsYXRpb25zaGlw>> : "Registra el expediente\n<size:16>[JSON/HTTPS]</size>"
TEFIIS.PaneldelTercio --> FirebaseAuthentication <<Relationship-UmVsYXRpb25zaGlw>> : "Inicia sesión\n<size:16>[Firebase SDK]</size>"
TEFIIS.PaneldelTercio --> TEFIIS.APITEFIIS <<Relationship-UmVsYXRpb25zaGlw>> : "Lista reclamos, cambia estados, registra cursos resueltos y responde\n<size:16>[JSON/HTTPS, token de Firebase]</size>"
TEFIIS.APITEFIIS --> FirebaseAuthentication <<Relationship-UmVsYXRpb25zaGlw>> : "Verifica el token\n<size:16>[Admin SDK]</size>"
TEFIIS.APITEFIIS --> GoogleGemini <<Relationship-UmVsYXRpb25zaGlw>> : "Envía preguntas con búsqueda en los reglamentos\n<size:16>[JSON/HTTPS]</size>"
TEFIIS.APITEFIIS --> Proveedoresdecorreo <<Relationship-UmVsYXRpb25zaGlw>> : "Envía códigos, confirmaciones y respuestas\n<size:16>[JSON/HTTPS]</size>"
TEFIIS.APITEFIIS --> TEFIIS.Basededatos <<Relationship-UmVsYXRpb25zaGlw>> : "Lee y escribe reclamos, respuestas, auditoría y configuración\n<size:16>[PostgREST/HTTPS]</size>"
TEFIIS.APITEFIIS --> TEFIIS.Archivos <<Relationship-UmVsYXRpb25zaGlw>> : "Guarda PDF y firma URL\n<size:16>[HTTPS]</size>"

@enduml